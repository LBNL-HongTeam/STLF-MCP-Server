# LoadForecasting-MCP environment variable reference.
# This application does not load .env files automatically. Export these
# variables in your shell or configure them through your process manager.

# Model storage location (default: ./models)
LOAD_FORECASTING_MODEL_DIR=./models

# MCP transport mode: "stdio" (default for Claude Desktop) or "http" (for agents)
MCP_TRANSPORT=stdio

# HTTP port (only used if MCP_TRANSPORT=http)
MCP_HTTP_PORT=8003

# Logging level
LOG_LEVEL=INFO

# --- OpenMP duplicate-runtime guard (macOS) ---
# xgboost links the Homebrew libomp while PyTorch/scipy load the venv libomp.
# Two OpenMP runtimes in one process can hard-crash (SIGSEGV) when a Torch
# model's historical_forecasts runs after xgboost has been used in the same
# long-lived server. main.py sets these defaults automatically; set them here
# (or in your shell) only if you launch the server without main.py.
# See AGENTS.md ("OpenMP duplicate-runtime crash").
KMP_DUPLICATE_LIB_OK=TRUE
OMP_NUM_THREADS=1
