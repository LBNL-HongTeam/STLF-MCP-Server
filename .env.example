# LoadForecasting-MCP Environment Configuration

# Model storage location (default: ./models)
LOAD_FORECASTING_MODEL_DIR=./models

# MCP transport mode: "stdio" (default for Claude Desktop) or "http" (for agents)
MCP_TRANSPORT=stdio

# HTTP port (only used if MCP_TRANSPORT=http)
MCP_HTTP_PORT=8003

# Logging level
LOG_LEVEL=INFO

# Development mode: load specs from local files instead of serving
# DEVELOPMENT_MODE=false
